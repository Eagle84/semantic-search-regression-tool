# Version control
.git
.gitignore

# Dependencies (will be installed in container)
node_modules
npm-debug.log*

# Environment files (should be provided at runtime)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs (created at runtime)
logs
*.log

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.idea
.vscode
*.sublime-project
*.sublime-workspace

# Distribution directories
dist
build

# Documentation (not needed in runtime)
*.md
!README.md
!DOCKER.md

# Test files
test
tests
*.test.js
*.spec.js

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore
